    "format": "prettier --write src",
    "lint": "eslint src",
    "build": "tsc",
    "start": "node dist/index.js",
    "proxy": "ssh -R 443:localhost:8080 tunnel.us.ngrok.com http",
    "dev": "yarn start & yarn proxy",
    "test": "NODE_OPTIONS=--experimental-vm-modules npx jest tests"
  }
