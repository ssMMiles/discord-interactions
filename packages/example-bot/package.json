{
  "name": "@discord-interactions/example-bot",
  "description": "An example Discord bot using @discord-interactions/core and fastify.",
  "version": "0.4.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "private": true,
  "dependencies": {
    "@discord-interactions/api": "^0.4.0",
    "@discord-interactions/builders": "^0.4.0",
    "@discord-interactions/core": "^0.4.0",
    "discord-api-types": "^0.38.52",
    "fastify": "^4.2.0",
    "fastify-raw-body": "^4.0.0",
    "redis": "^4.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^22.15.0",
    "@types/node-fetch": "^2.6.1",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "dotenv": "^13.0.0",
    "jest": "^29.7.0",
    "prettier": "^2.6.2",
    "rimraf": "^4.3.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.4.0",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.2.10",
    "typescript": "^5.5.4"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "discord",
    "interactions",
    "slash commands",
    "framework",
    "api",
    "wrapper"
