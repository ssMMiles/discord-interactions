{
  "name": "@discord-interactions/discord-interactions",
  "version": "0.0.1",
  "scripts": {
    "bootstrap": "yarn install",
    "clean": "lerna clean",
    "build": "lerna run build",
    "format": "lerna run format",
    "lint": "lerna run lint",
    "docs": "lerna run docs",
    "test": "lerna run test",
    "example": "yarn build && lerna run dev --scope=@discord-interactions/example-bot",
    "example:worker": "yarn build && lerna run dev --scope=@discord-interactions/example-bot-worker",
    "prepublishOnly": "yarn build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "lerna": "^5.1.8",
    "nx": "^14.4.2",
    "prettier": "^2.7.1",
    "rimraf": "^3.0.2",
    "ts-jest": "^29.2.5",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.2.10",
    "typescript": "^5.5.4"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*"
  ],
  "resolutions": {
    "typescript": "^5.9.3"
  }
}
